+// Integrate only the finite camera-to-cloud segment when the two top-of-atmosphere
+// transmittances are too small to recover their ratio. This path is for grazing
+// optically thick rays; unlike division of two fp16 LUT texels it gives T(0) = 1.
+vec3 cloudFiniteAirTransmittance(float tKm, float startAltitude, float endAltitude,
+                                 float viewUp, AtmosphereArgs args) {
+  const float midpoint = 0.5f * tKm;
+  const float eyeRadius = args.planetRadius + startAltitude;
+  const float delta = midpoint * (2.0f * eyeRadius * viewUp + midpoint);
+  const float midAltitude = max(0.0f, startAltitude + delta /
+    (sqrt(max(0.0f, eyeRadius * eyeRadius + delta)) + eyeRadius));
+  const vec3 sigma = sampleAtmosphereMedium(startAltitude, args).extinction
+                   + 4.0f * sampleAtmosphereMedium(midAltitude, args).extinction
+                   + sampleAtmosphereMedium(endAltitude, args).extinction;
+  return exp(-sigma * (tKm / 6.0f));
+}
